    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="senhaUm" type="Integer" array="False" size=""/>
            <declare name="senhaDois" type="Integer" array="False" size=""/>
            <output expression="&quot;Insira sua senha para acessar sua conta banc&#225;ria:&quot;" newline="True"/>
            <input variable="senhaUm"/>
            <output expression="&quot;Digite a senha novamente para completar a etapa de seguran&#231;a&quot;" newline="True"/>
            <input variable="senhaDois"/>
            <if expression="senhaDois = senhaUm">
                <then>
                    <output expression="&quot;Acesso permitido&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Acesso negado, tente novamente&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
