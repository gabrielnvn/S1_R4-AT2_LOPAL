    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="alturaUm" type="Real" array="False" size=""/>
            <output expression="&quot;Quantos metros voc&#234; tem?&quot;" newline="True"/>
            <input variable="alturaUm"/>
