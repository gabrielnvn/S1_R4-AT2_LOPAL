    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valorUm" type="Real" array="False" size=""/>
            <declare name="result" type="Real" array="False" size=""/>
            <output expression="&quot; Quanto deu sua compra&quot;" newline="True"/>
            <input variable="valorUm"/>
            <if expression="valorUm &gt;= 150">
                <then>
                    <output expression="&quot; Voc&#234; ganhou um desconto de &quot; &amp;valorUm*2/100&amp; &quot; reais, sua comprar ficou no valor ser&#225; de &quot; &amp;valorUm - valorUm*2/100" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Sua compra deu &quot; &amp;valorUm&amp; &quot; reais e ter&#225; um cashback de &quot; &amp;valorUm*2/100&amp; &quot; reais&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
